---
// Vista previa: la hamburguesa se apila en vivo (data-stack) + extras + total.
import Icon from '../Icon.astro';
interface Props { kiosk?: boolean; class?: string }
const { kiosk = false, class: cls = '' } = Astro.props;
---
<div data-preview class:list={['relative overflow-hidden grid-pattern rounded-2xl bg-navy text-white shadow-2xl shadow-navy/20 flex flex-col', kiosk ? 'p-5' : 'p-4 sm:p-6', cls]}>
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at 50% 55%, rgba(51,108,255,.55) 0, transparent 58%)"></div>

  <div class="relative flex items-center justify-between gap-3">
    {kiosk ? (
      <p class="font-display font-black uppercase text-2xl tracking-tight truncate" data-summary-name>Mi burger</p>
    ) : (
      <label class="flex items-center gap-2 min-w-0 flex-1">
        <Icon name="tabler:pencil" class="h-4 w-4 text-brand shrink-0" />
        <input data-name value="Mi burger" maxlength="28" aria-label="Nombre de tu burger"
          class="bg-transparent font-display font-black uppercase text-xl sm:text-2xl tracking-tight outline-none border-b-2 border-transparent focus:border-brand w-full min-w-0" />
      </label>
    )}
    <button data-reset class:list={['shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-white/10 font-semibold text-white/80 hover:bg-white/20 hover:text-white transition', kiosk ? 'px-4 py-2.5 text-sm' : 'px-3 py-1.5 text-xs']}>
      <Icon name="tabler:refresh" class={kiosk ? 'h-5 w-5' : 'h-3.5 w-3.5'} /> Reiniciar
    </button>
  </div>

  <!-- caja de alto fijo: la hamburguesa se ajusta dentro (ver fitStack en scripts/builder.ts) -->
  <div class:list={['relative flex items-end justify-center', kiosk ? 'flex-1 min-h-0 py-4' : 'h-[270px] sm:h-[380px] py-5']}>
    <div data-stack data-max-width={kiosk ? 280 : 300} class="flex flex-col items-center transition-[width] duration-500 ease-out" style={`width:${kiosk ? 280 : 300}px`}></div>
  </div>

  <!-- combo (papas + bebida) arriba y total abajo: nunca se pisan -->
  <div class="relative shrink-0 rounded-xl bg-white/5 border border-white/10">
    <div data-extras class:list={['flex items-end justify-center gap-4 px-4 pt-3 pb-2', kiosk ? 'min-h-[6.5rem]' : 'min-h-[5rem]']}></div>
    <div class="flex items-center justify-between gap-3 border-t border-white/10 px-4 py-3">
      <p class="text-[11px] text-white/50 font-semibold uppercase tracking-widest">Total</p>
      <p data-total class:list={['font-display font-black leading-none', kiosk ? 'text-4xl' : 'text-3xl sm:text-4xl']}>$0.00</p>
    </div>
  </div>
</div>
